# Server-only config for the Hono API (apps/api), read via src/config/env.ts.
# Never commit a real .env file. The service role key and SMTP password must
# never reach the browser or the repo (RULES.md Security rule 2).

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-real-service-role-key

# Session cookie and lifetime settings (see packages/shared constants).
SESSION_COOKIE_NAME=tcd_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Exact origin of the deployed frontend. Never "*" (RULES.md: never use "*"
# as the CORS origin or send credentials to other origins).
CORS_ORIGIN=https://growviaai.github.io

# Full base URL the frontend is served from, including any sub-path (e.g. a
# GitHub Pages project page). Only used to build invite/reset links in
# emails — never for CORS, which is CORS_ORIGIN above.
FRONTEND_URL=https://growviaai.github.io/test-company-docs

NODE_ENV=production
