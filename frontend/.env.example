# Build-time config for the static Vite build (apps/web).
# Never put secrets here — anything prefixed VITE_ is bundled into the
# public, client-side JS bundle (RULES.md "Put secrets in VITE_ variables").

# Base URL of the deployed API (apps/api on Vercel). No trailing slash.
VITE_API_BASE_URL=https://test-company-docs.vercel.app

# Sub-path the app is served from. "/" for a custom domain or root deploy,
# "/<repo-name>/" for a GitHub Pages project page.
VITE_BASE_PATH=/
