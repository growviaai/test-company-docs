# Build-time config for the static Vite build (frontend/).
# Never put secrets here — anything prefixed VITE_ is bundled into the
# public, client-side JS bundle (RULES.md "Put secrets in VITE_ variables").

# Base URL of the deployed API (backend/ on Vercel). No trailing slash.
VITE_API_BASE_URL=https://test-company-docs.vercel.app

# Sub-path the app is served from. "/" for Cloudflare Pages (root domain)
# or a custom domain; "/<repo-name>/" only if ever served from a GitHub
# Pages project page instead.
VITE_BASE_PATH=/
